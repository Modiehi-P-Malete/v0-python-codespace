     "text": [
      "olleh\n",
      "nohtyP\n"
     ]
    }
   ],
   "source": [
    "def reverse_string(str):\n",
    "    return str[::-1]\n",
    "\n",
    "print(reverse_string(\"hello\"))   # olleh\n",
    "print(reverse_string(\"Python\"))  # nohtyP\n",
    "\n"
   ]
  }
