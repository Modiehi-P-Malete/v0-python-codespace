   "source": [
    "Write a function reverse_string(text) that returns the reversed string."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0d73f094",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
