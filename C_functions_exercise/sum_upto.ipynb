   "source": [
    "Write `sum_upto(n)`\n",
    "\n",
    "Return the sum of numbers from 1 → n."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "15a8b72d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "15\n",
      "55\n"
     ]
    }
   ],
   "source": [
    "def sum_upto(n):\n",
    "    total = 0\n",
    "    for i in range(1, n + 1):\n",
    "        total += i\n",
    "    return total\n",
    "\n",
    "print(sum_upto(5))   # 15\n",
    "print(sum_upto(10))  # 55\n",
    "\n"
   ]
  }
 ],
