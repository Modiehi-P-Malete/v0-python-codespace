   "source": [
    "Write a function `larger(a, b)`\n",
    "\n",
    "Return the **larger** of the two numbers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9618e5a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def larger(a, b):\n",
    "    return a if a > b else b\n",
    "\n",
    "print(larger(256, 400))   # 400\n",
    "print(larger(31, 4))      # 31\n",
    "print(larger(-6, 7))      # 7\n",
    "print(larger(11.3, 11.2)) # 11.3\n",
    "print(larger(-10, -3))    # -3\n",
    "\n"
   ]
  }
 ],
