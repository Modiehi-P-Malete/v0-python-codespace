   "source": [
    "Write average_of_four(a, b, c, d) that returns the average of four numbers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "b250e6ac",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "7.25\n",
      "13.75\n",
      "5.0\n"
     ]
    }
   ],
   "source": [
    "def average_of_four(a, b, c, d):\n",
    "    return (a+b+c+d)/4\n",
    "\n",
    "print(average_of_four(10, 4, 12, 3))     # 7.25\n",
    "print(average_of_four(-20, 50, 4, 21))   # 13.75\n",
    "print(average_of_four(5, 5, 3, 7))       # 5\n",
    "\n"
   ]
  }
 ],
