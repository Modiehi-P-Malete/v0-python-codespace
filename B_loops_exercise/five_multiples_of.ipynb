   "source": [
    "Write a function `five_multiples_of(n)` that prints the first five multiples of n.\n",
    "The function does not return a value, just prints.\n",
    "\n",
    "Example:\n",
    "\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "824fdbea",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "7\n",
      "14\n",
      "21\n",
      "28\n",
      "35\n"
     ]
    }
   ],
   "source": [
    "def five_multiples_of(n):\n",
    "    for i in range(1, 6):\n",
    "        print(n * i)\n",
    "\n",
    "\n",
    "five_multiples_of(7)\n",
    "\n",
    "# 7\n",
    "# 14\n",
    "# 21\n",
    "# 28\n",
    "# 35\n"
   ]
  }
