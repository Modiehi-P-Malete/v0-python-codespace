   "source": [
    "Write a function `no_ohs(text)` that prints each character of the string except 'o'.\n",
    "The function does not return a value, just prints.\n",
    "\n",
    "Example:\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e1001e96",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "c\n",
      "d\n",
      "e\n"
     ]
    }
   ],
   "source": [
    "def no_ohs(text):\n",
    "    for char in text:\n",
    "        if char != 'o':\n",
    "            print(char)\n",
    "\n",
    "\n",
    "no_ohs(\"code\")\n",
    "# c\n",
    "# d\n",
    "# e\n",
    "\n"
   ]
  }
 ],
