   ],
   "source": [
    "def min_to_max(min_num, max_num):\n",
    "    for n in range(min_num, max_num+1):\n",
    "        print(n)\n",
    "\n",
    "min_to_max(5, 9)\n",
    "min_to_max(11, 13)\n",
    "min_to_max(20, 11)   # what happens here?"
   ]
  }
