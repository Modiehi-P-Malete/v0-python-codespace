   "source": [
    "Write a function `evens(max_num)` that prints all positive even numbers LESS than max_num.\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "c36d5816",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2\n",
      "4\n",
      "6\n",
      "8\n",
      "10\n",
      "-----------\n",
      "2\n",
      "4\n",
      "6\n"
     ]
    }
   ],
   "source": [
    "def evens(max_num):\n",
    "    for n in range(2, max_num, 2):\n",
    "        print(n)\n",
    "\n",
    "evens(11)\n",
    "print(\"-----------\")\n",
    "evens(8)"
   ]
  }
