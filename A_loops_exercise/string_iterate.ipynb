   "source": [
    "Write a function `string_iterate(text)` that prints each character of the string."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "7a6a15db",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "c\n",
      "e\n",
      "l\n",
      "e\n",
      "r\n",
      "y\n",
      "h\n",
      "a\n",
      "t\n"
     ]
    }
   ],
   "source": [
    "def string_iterate(text):\n",
    "    for char in text:\n",
    "        print(char)\n",
    "\n",
    "string_iterate(\"celery\")\n",
    "string_iterate(\"hat\")"
   ]
