     ]
    }
   ],
   "source": [
    "def count_up(max_num):\n",
    "    for i in range(1, max_num + 1):\n",
    "        print(i)\n",
    "\n",
    "count_up(5)\n",
    "print(\"--------------------------\") \n",
    "count_up(3)"
   ]
  }
