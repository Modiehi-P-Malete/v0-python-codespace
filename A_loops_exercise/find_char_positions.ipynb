   "source": [
    "Write a function that prints all indexes where a character appears in a string."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5d3339b6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1\n",
      "3\n",
      "5\n"
     ]
    }
   ],
   "source": [
    "def find_char_positions(text, char):\n",
    "    for i in range(len(text)):\n",
    "        if text[i] == char:\n",
    "            print(i)\n",
    "\n",
    "find_char_positions(\"banana\", \"a\")\n",
    "# 1\n",
    "# 3\n",
    "# 5\n"
   ]
  }
 ],
